<?xml version="1.0" encoding="utf-8"?><!--
  ~ Background tint for hex / Connect keys on Android TV.
  ~ Focused/pressed → on_surface (inverted, very bright), default → primary accent.
  -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:color="@color/wgk_on_surface" />
    <item android:state_pressed="true" android:color="@color/wgk_on_surface" />
    <item android:color="@color/wgk_primary" />
</selector>
