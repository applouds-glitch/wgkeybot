<?xml version="1.0" encoding="utf-8"?><!--
  ~ Text colour for hex / Connect keys on Android TV.
  ~ Focused/pressed text turns primary so it stays legible against the inverted fill.
  -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:color="@color/wgk_primary" />
    <item android:state_pressed="true" android:color="@color/wgk_primary" />
    <item android:color="@color/wgk_on_primary" />
</selector>
