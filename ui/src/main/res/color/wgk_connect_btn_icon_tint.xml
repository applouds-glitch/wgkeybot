<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Connected -->
    <item android:state_selected="true"  android:color="@color/wgk_on_success" />
    <!-- Connecting / Handshake -->
    <item android:state_activated="true" android:color="@color/wgk_connect_busy_content" />
    <!-- Disconnected -->
    <item android:color="@color/wgk_connect_idle_content" />
</selector>
