<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- TextInputLayout needs a stateful list to set the resting outline too. -->
    <item android:state_enabled="false" android:color="@color/wgk_on_surface" android:alpha="0.12" />
    <item android:state_focused="true" android:color="@color/wgk_primary" />
    <item android:state_hovered="true" android:color="@color/wgk_on_surface" />
    <item android:color="@color/wgk_outline" />
</selector>
