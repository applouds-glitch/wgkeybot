<?xml version="1.0" encoding="utf-8"?><!--
  ~ Stroke colour for TV D-pad keys: bright accent border only while focused.
  -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:color="@color/wgk_primary" />
    <item android:state_pressed="true" android:color="@color/wgk_primary" />
    <item android:color="@android:color/transparent" />
</selector>
