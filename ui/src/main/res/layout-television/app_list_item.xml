<?xml version="1.0" encoding="utf-8"?><!--
  ~ Android TV variant of the split-tunneling list row.
  ~ Whole row is D-pad focusable with a visible focus highlight; resolved only
  ~ on uiMode=television devices. Keeps the databinding variables and ids of the default row.
  -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <import type="com.wireguard.android.model.ApplicationData" />
        <variable
            name="collection"
            type="com.wireguard.android.databinding.ObservableKeyedArrayList&lt;String, com.wireguard.android.model.ApplicationData&gt;" />
        <variable
            name="key"
            type="String" />
        <variable
            name="item"
            type="com.wireguard.android.model.ApplicationData" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:layout_marginVertical="2dp"
        android:background="@drawable/wgk_tv_row_bg"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:onClick="@{(view) -> item.setSelected(!item.selected)}"
        android:orientation="horizontal"
        android:paddingVertical="10dp">

        <ImageView
            android:id="@+id/app_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="14dp"
            android:src="@{item.icon}"
            tools:src="@tools:sample/avatars" />

        <TextView
            android:id="@+id/app_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@{key}"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="@color/wgk_on_surface"
            tools:text="@tools:sample/full_names" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/selected_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="14dp"
            android:checked="@={item.selected}"
            android:clickable="false"
            android:focusable="false" />

    </LinearLayout>
</layout>
