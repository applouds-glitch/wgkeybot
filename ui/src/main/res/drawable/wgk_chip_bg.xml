<?xml version="1.0" encoding="utf-8"?>
<!--
  ~ Background for the chip that sits in the action slot under the connect
  ~ button. A tinted pill rather than an outlined one: the chip only ever appears
  ~ to report something that is already running, and it has to read as a live
  ~ badge next to the button, not as a third button competing with it.
  -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/wgk_primary_12">

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/wgk_primary_12" />
            <stroke android:width="1dp" android:color="@color/wgk_primary_30" />
        </shape>
    </item>

    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@android:color/white" />
        </shape>
    </item>
</ripple>
