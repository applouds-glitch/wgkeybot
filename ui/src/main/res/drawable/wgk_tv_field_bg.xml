<?xml version="1.0" encoding="utf-8"?><!--
  ~ The key field over the TV keyboard: wgk_surface_container_low under a 1dp
  ~ wgk_outline_variant border. Not focusable — the keys write into it — so no
  ~ focus state.
  -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="@dimen/wgk_tv_row_radius" />
    <solid android:color="@color/wgk_surface_container_low" />
    <stroke
        android:width="@dimen/wgk_tv_keycap_stroke"
        android:color="@color/wgk_outline_variant" />
</shape>
