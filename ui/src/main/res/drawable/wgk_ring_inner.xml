<?xml version="1.0" encoding="utf-8"?>
<!-- Innermost halo ring — doubles as the track the busy arc sweeps along, so its
     diameter must match wgk_busy_arc. Size and alpha set in layout. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <stroke android:width="1dp" android:color="@color/wgk_outline" />
    <solid android:color="@android:color/transparent" />
</shape>
