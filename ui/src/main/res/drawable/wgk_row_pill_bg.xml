<?xml version="1.0" encoding="utf-8"?>
<!--
  ~ A quietly outlined surface for secondary navigation. Keyboard and TV
  ~ focus retain a stronger outline.
  -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/wgk_primary_12">

    <item>
        <selector>
            <item android:state_focused="true">
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/wgk_footer_corner" />
                    <solid android:color="@color/wgk_surface_container_high" />
                    <stroke android:width="2dp" android:color="@color/wgk_primary" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/wgk_footer_corner" />
                    <solid android:color="@color/wgk_footer_surface" />
                    <stroke android:width="@dimen/wgk_card_stroke_width" android:color="@color/wgk_card_outline" />
                </shape>
            </item>
        </selector>
    </item>

    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/wgk_footer_corner" />
            <solid android:color="@android:color/white" />
        </shape>
    </item>
</ripple>
