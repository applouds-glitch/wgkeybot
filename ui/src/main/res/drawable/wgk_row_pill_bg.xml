<?xml version="1.0" encoding="utf-8"?>
<!--
  ~ Background for the full-width footer rows. Reproduces the outlined pill the
  ~ rows used to get from materialButtonOutlinedStyle, minus that style's 6dp
  ~ vertical insets — here the 48dp touch target and the 48dp pill are the same
  ~ box. The focused state is what Android TV lands on with the D-pad.
  -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/wgk_primary_12">

    <item>
        <selector>
            <item android:state_focused="true">
                <shape android:shape="rectangle">
                    <corners android:radius="24dp" />
                    <solid android:color="@color/wgk_surface_container_high" />
                    <stroke android:width="2dp" android:color="@color/wgk_primary" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="24dp" />
                    <solid android:color="@color/wgk_surface_container_low" />
                    <stroke android:width="1dp" android:color="@color/wgk_outline" />
                </shape>
            </item>
        </selector>
    </item>

    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="@android:color/white" />
        </shape>
    </item>
</ripple>
