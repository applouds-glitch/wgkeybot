<?xml version="1.0" encoding="utf-8"?><!--
  ~ The explanatory note at the foot of a TV settings pane, a shade below the
  ~ option rows (wgk_surface_container_low) so it reads as a footnote and not
  ~ as one more option.
  -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="@dimen/wgk_tv_row_radius" />
    <solid android:color="@color/wgk_surface_container_low" />
</shape>
