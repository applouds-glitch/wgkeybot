<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- A row that carries its own switch, shaped like the navigation row next to
         it (48dp tinted icon tile, title over a value line) so a card can mix the
         two without a seam. The switch is inert and driven by the row: a tap
         anywhere on the row toggles it, and a tap that lands on the switch itself
         falls through to the same handler. -->
    <LinearLayout
        android:id="@+id/wgk_switch_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="@dimen/wgk_settings_row_min"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/wgk_profile_tile_bg">

            <ImageView
                android:id="@+id/wgk_switch_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                app:tint="@color/wgk_primary" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/wgk_switch_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="@color/wgk_on_surface" />

            <TextView
                android:id="@+id/wgk_switch_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/wgk_on_surface_variant" />
        </LinearLayout>

        <!-- saveEnabled=false, and it is not optional. This row is included
             three times on the settings screen, so three switches carry this
             same id — an <include> renames the root and nothing below it. View
             state is a SparseArray keyed by id, so on a recreation (switching
             the theme causes one) whichever switch was saved last would be
             restored into all three, and it would land after onCreate, on top
             of everything the bind pass had just set from the stored values.
             Nothing is lost by not saving: each of these switches is a
             projection of a preference that is read again on every bind. -->
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/wgk_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:clickable="false"
            android:focusable="false"
            android:saveEnabled="false" />
    </LinearLayout>
</layout>
