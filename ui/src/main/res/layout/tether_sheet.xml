<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/wgk_background">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/wgk_tether_title"
                android:textAppearance="?attr/textAppearanceTitleLarge"
                android:textColor="@color/wgk_on_surface" />

            <!-- Details only: the switch lives on the settings row that opens
                 this sheet, and that row only exists while an access point is up.
                 A switch here as well would turn the sheet off under itself and
                 leave a stub of a sheet standing with nothing in it — the sheet
                 closes on that state instead, see TetherSheet.render(). -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/wgk_tether_qr"
                    android:layout_width="180dp"
                    android:layout_height="180dp"
                    android:layout_gravity="center_horizontal"
                    android:contentDescription="@string/wgk_tether_qr_cd" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/wgk_tether_qr_hint"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="@color/wgk_on_surface_variant" />

                <include
                    android:id="@+id/wgk_tether_ssid_row"
                    layout="@layout/view_wgk_copy_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />

                <include
                    android:id="@+id/wgk_tether_pass_row"
                    layout="@layout/view_wgk_copy_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    android:id="@+id/wgk_tether_proxy_row"
                    layout="@layout/view_wgk_copy_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    android:id="@+id/wgk_tether_pac_row"
                    layout="@layout/view_wgk_copy_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/wgk_tether_counters"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="@color/wgk_on_surface" />

                <!-- Not a caveat but the guarantee: the access point has no NAT of
                     its own, so anything not pointed at the proxy simply fails
                     instead of quietly bypassing the tunnel. -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/wgk_tether_proxy_required"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="@color/wgk_warning" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingMultiplier="1.3"
                    android:text="@string/wgk_tether_howto"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="@color/wgk_on_surface_variant" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</layout>
