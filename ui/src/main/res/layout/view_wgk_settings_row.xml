<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- A row that leads somewhere else — a sheet or another screen — and says so
         with a chevron. It is a plain row rather than a card of its own: the
         section card around it draws the outline and the corners now, and a card
         inside a card would put two outlines a padding apart. Shape stays in step
         with view_wgk_settings_switch_row so a card can hold both. -->
    <LinearLayout
        android:id="@+id/wgk_row_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="@dimen/wgk_settings_row_min"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/wgk_profile_tile_bg">

            <ImageView
                android:id="@+id/wgk_row_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                app:tint="@color/wgk_primary" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/wgk_row_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="@color/wgk_on_surface" />

            <!-- The label stays quiet and the value carries the state. -->
            <TextView
                android:id="@+id/wgk_row_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/wgk_on_surface_variant" />
        </LinearLayout>

        <ImageView
            android:id="@+id/wgk_row_chevron"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/wgk_on_surface_variant" />
    </LinearLayout>
</layout>
