<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <!-- The icon keeps a 48dp touch target while the content follows the action-row grid. -->
    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.WGKeyBot.InstrumentCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="46dp"
                android:paddingEnd="16dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/wgk_profile_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/wgk_profile_name"
                        android:textAppearance="@style/TextAppearance.WGKeyBot.SettingTitle"
                        android:textColor="@color/wgk_on_surface_variant" />
                    <TextView
                        android:id="@+id/wgk_profile_loaded"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:importantForAccessibility="no"
                        android:maxLines="1"
                        android:text="@string/wgk_profile_never_loaded"
                        android:textAppearance="@style/TextAppearance.WGKeyBot.InstrumentValue" />
                </LinearLayout>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/wgk_refresh_btn"
                    style="@style/Widget.WGKeyBot.ConfigAction"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/wgk_profile_refresh_cd"
                    app:icon="@drawable/ic_refresh" />
            </LinearLayout>
            <FrameLayout
                android:id="@+id/wgk_profile_icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="1dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless">
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_cloud"
                    app:tint="@color/wgk_leading_icon" />
            </FrameLayout>
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>
