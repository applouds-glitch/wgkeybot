<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.WGKeyBot.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp">

            <FrameLayout
                android:id="@+id/wgk_profile_icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/wgk_profile_tile_bg">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_cloud"
                    app:tint="@color/wgk_primary" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/wgk_profile_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/wgk_profile_name"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="@color/wgk_on_surface" />

                <TextView
                    android:id="@+id/wgk_profile_loaded"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="@color/wgk_on_surface_variant"
                    android:text="@string/wgk_profile_never_loaded" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/wgk_auto_refresh_btn"
                style="?attr/materialIconButtonOutlinedStyle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@string/wgk_auto_refresh_cd"
                app:icon="@drawable/ic_auto_renew"
                app:iconGravity="textTop"
                app:iconPadding="0dp"
                app:iconSize="18dp"
                app:iconTint="@color/wgk_primary"
                app:strokeColor="@color/wgk_outline" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/wgk_refresh_btn"
                style="?attr/materialIconButtonOutlinedStyle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:contentDescription="@string/wgk_profile_refresh_cd"
                app:icon="@drawable/ic_refresh"
                app:iconGravity="textTop"
                app:iconPadding="0dp"
                app:iconSize="18dp"
                app:iconTint="@color/wgk_primary"
                app:strokeColor="@color/wgk_outline" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>
