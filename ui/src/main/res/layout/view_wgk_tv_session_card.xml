<?xml version="1.0" encoding="utf-8"?><!--
  ~ Android TV only, though it sits in layout/ (lint wants a default for every
  ~ layout, and only layout-television includes it): the mock's СЕАНС card at the top of the right column, with
  ~ the session's time and traffic. The three values carry the ids they have in
  ~ the status zone; this is a binding class of its own, so the two do not
  ~ collide, and TunnelListFragment writes to both. A dash until connected.
  -->
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/wgk_tv_card_bg"
        android:orientation="vertical"
        android:paddingStart="@dimen/wgk_tv_card_pad_h"
        android:paddingTop="@dimen/wgk_tv_card_pad_v"
        android:paddingEnd="@dimen/wgk_tv_card_pad_h"
        android:paddingBottom="@dimen/wgk_tv_card_pad_v">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                style="@style/Widget.WGKeyBot.Tv.MonoLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/wgk_tv_session_title" />

            <TextView
                android:id="@+id/wgk_tv_session_tag"
                style="@style/Widget.WGKeyBot.Tv.MonoLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/wgk_wireguard_label" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/wgk_tv_card_gap"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Widget.WGKeyBot.Tv.MetricLabel"
                    android:text="@string/wgk_tv_metric_time" />

                <TextView
                    android:id="@+id/wgk_uptime_value"
                    style="@style/Widget.WGKeyBot.Tv.MetricValue" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/wgk_tv_metric_gap"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Widget.WGKeyBot.Tv.MetricLabel"
                    android:text="@string/wgk_tv_metric_received" />

                <TextView
                    android:id="@+id/wgk_received_value"
                    style="@style/Widget.WGKeyBot.Tv.MetricValue" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/wgk_tv_metric_gap"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Widget.WGKeyBot.Tv.MetricLabel"
                    android:text="@string/wgk_tv_metric_sent" />

                <TextView
                    android:id="@+id/wgk_sent_value"
                    style="@style/Widget.WGKeyBot.Tv.MetricValue" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</layout>
