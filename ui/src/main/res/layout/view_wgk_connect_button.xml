<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Every diameter here is a dimen so the control can shrink on short
         screens; the buckets live in values/dimens.xml (+ -h680dp / -h760dp) and
         keep the ring proportions. The TV variant in layout-television keeps its
         own literals — it is laid out beside the status column, not above it, so
         it never competes for vertical space. -->
    <FrameLayout
        android:layout_width="@dimen/wgk_connect_ring_outer"
        android:layout_height="@dimen/wgk_connect_ring_outer">

        <!-- Both themes use the static v1.6.0 halo and the same initial alphas.
             Theme colours provide the contrast and radial falloff. -->
        <View
            android:id="@+id/wgk_ring_outer"
            style="@style/Widget.WGKeyBot.ConnectRing.Outer"
            android:layout_width="@dimen/wgk_connect_ring_outer"
            android:layout_height="@dimen/wgk_connect_ring_outer"
            android:layout_gravity="center"
            android:background="@drawable/wgk_ring_outer" />

        <View
            android:id="@+id/wgk_ring_mid"
            style="@style/Widget.WGKeyBot.ConnectRing.Middle"
            android:layout_width="@dimen/wgk_connect_ring_mid"
            android:layout_height="@dimen/wgk_connect_ring_mid"
            android:layout_gravity="center"
            android:background="@drawable/wgk_ring_mid" />

        <View
            android:id="@+id/wgk_ring_inner"
            style="@style/Widget.WGKeyBot.ConnectRing.Inner"
            android:layout_width="@dimen/wgk_connect_ring_inner"
            android:layout_height="@dimen/wgk_connect_ring_inner"
            android:layout_gravity="center"
            android:background="@drawable/wgk_ring_inner" />

        <!-- A separate busy arc just outside the inner ring, as in v1.6.0. -->
        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/wgk_busy_arc"
            android:layout_width="@dimen/wgk_connect_arc"
            android:layout_height="@dimen/wgk_connect_arc"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorColor="@color/wgk_primary"
            app:indicatorSize="@dimen/wgk_connect_arc"
            app:trackColor="@android:color/transparent"
            app:trackThickness="3dp"
            app:indeterminateAnimationType="disjoint" />

        <!-- Connect / disconnect button. The size and icon size override the
             style's defaults, which the TV variant still relies on. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/wgk_connect_btn"
            style="@style/Widget.WGKeyBot.ConnectButton"
            android:layout_width="@dimen/wgk_connect_btn"
            android:layout_height="@dimen/wgk_connect_btn"
            android:layout_gravity="center"
            android:contentDescription="@string/wgk_headline_disconnected"
            app:backgroundTint="@color/wgk_connect_btn_background_tint"
            app:icon="@drawable/ic_power"
            app:iconSize="@dimen/wgk_connect_icon"
            app:iconTint="@color/wgk_connect_btn_icon_tint" />
    </FrameLayout>
</layout>
