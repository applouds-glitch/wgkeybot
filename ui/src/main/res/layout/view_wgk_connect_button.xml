<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <FrameLayout
        android:layout_width="260dp"
        android:layout_height="260dp">

        <!-- Outer ring — alpha 0.18 -->
        <View
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:layout_gravity="center"
            android:alpha="0.18"
            android:background="@drawable/wgk_ring_outer" />

        <!-- Middle ring — alpha 0.28 -->
        <View
            android:layout_width="224dp"
            android:layout_height="224dp"
            android:layout_gravity="center"
            android:alpha="0.28"
            android:background="@drawable/wgk_ring_mid" />

        <!-- Inner ring — alpha 0.42 -->
        <View
            android:layout_width="192dp"
            android:layout_height="192dp"
            android:layout_gravity="center"
            android:alpha="0.42"
            android:background="@drawable/wgk_ring_inner" />

        <!-- Busy arc during Connecting / Handshake -->
        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/wgk_busy_arc"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorColor="@color/wgk_primary"
            app:indicatorSize="200dp"
            app:trackThickness="3dp"
            app:indeterminateAnimationType="disjoint" />

        <!-- Connect / disconnect button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/wgk_connect_btn"
            style="@style/Widget.WGKeyBot.ConnectButton"
            android:layout_gravity="center"
            android:contentDescription="@string/wgk_headline_disconnected"
            app:backgroundTint="@color/wgk_connect_btn_background_tint"
            app:icon="@drawable/ic_power"
            app:iconTint="@color/wgk_connect_btn_icon_tint" />
    </FrameLayout>
</layout>
