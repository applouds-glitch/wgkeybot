<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Same skeleton as app_settings_activity.xml: toolbar over a scrolling,
         width-capped column of cards; insets applied in the activity. -->
    <LinearLayout
        android:id="@+id/wgk_routing_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/wgk_background"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/wgk_routing_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:title="@string/wgk_routing_settings_title"
            app:titleTextColor="@color/wgk_on_surface" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/wgk_routing_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="ifContentScrolls">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/wgk_settings_gutter"
                    android:paddingTop="12dp"
                    android:paddingEnd="@dimen/wgk_settings_gutter"
                    android:paddingBottom="24dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintWidth_max="@dimen/wgk_settings_content_max">

                    <!-- Source: the profile address and the direct-route resolver.
                         Both edited through a dialog — a row with a value reads
                         like the rest of the settings, a bare text field does not. -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:text="@string/wgk_routing_section_source"
                        android:textAppearance="@style/TextAppearance.WGKeyBot.SectionHeader" />

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.WGKeyBot.Card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <include
                                android:id="@+id/wgk_routing_url_row"
                                layout="@layout/view_wgk_settings_row"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginStart="16dp"
                                android:background="@color/wgk_outline_variant" />

                            <include
                                android:id="@+id/wgk_routing_dns_row"
                                layout="@layout/view_wgk_settings_row"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Files: what is on disk, read-only, and the button that
                         refreshes it. -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/wgk_settings_section_gap"
                        android:layout_marginBottom="8dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:text="@string/wgk_routing_section_files"
                        android:textAppearance="@style/TextAppearance.WGKeyBot.SectionHeader" />

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.WGKeyBot.Card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <include
                                android:id="@+id/wgk_routing_profile_row"
                                layout="@layout/view_wgk_settings_row"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginStart="16dp"
                                android:background="@color/wgk_outline_variant" />

                            <include
                                android:id="@+id/wgk_routing_geoip_row"
                                layout="@layout/view_wgk_settings_row"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginStart="16dp"
                                android:background="@color/wgk_outline_variant" />

                            <include
                                android:id="@+id/wgk_routing_geosite_row"
                                layout="@layout/view_wgk_settings_row"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginStart="16dp"
                                android:background="@color/wgk_outline_variant" />

                            <include
                                android:id="@+id/wgk_routing_fetched_row"
                                layout="@layout/view_wgk_settings_row"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/wgk_routing_update_btn"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_marginTop="4dp"
                                android:layout_marginEnd="12dp"
                                android:layout_marginBottom="12dp"
                                android:text="@string/wgk_routing_update_btn"
                                app:icon="@drawable/ic_refresh" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- The outcome of the last update, and the standing note on
                         how fetching works. -->
                    <TextView
                        android:id="@+id/wgk_routing_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="@color/wgk_on_surface_variant"
                        android:visibility="gone" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingMultiplier="1.3"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:text="@string/wgk_routing_note"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="@color/wgk_on_surface_variant" />
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</layout>
