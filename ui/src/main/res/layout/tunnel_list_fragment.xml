<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/main_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/wgk_background">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Pinned header, deliberately outside the scroll view. The stack
                 below is fixed-height (status card + footer rows never shrink),
                 so on a short viewport — a 16:9 phone, landscape, or any device
                 whose display-size / font setting eats height — it has to scroll,
                 and the profile card was the first thing to leave the screen. It
                 reports which config is loaded and carries the refresh controls,
                 so it stays put and only the control stack below scrolls. -->
            <include
                android:id="@+id/wgk_profile_card"
                layout="@layout/view_wgk_profile_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="@dimen/wgk_screen_pad_top"
                android:layout_marginEnd="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- The phone layout must remain usable on short screens, in landscape,
                 and with large accessibility fonts. Sizes inside come from the
                 height-bucketed dimens (values/dimens.xml + -h680dp / -h760dp), so
                 the ring gives up diameter before the stack starts to scroll. -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/wgk_content_scroll"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:overScrollMode="ifContentScrolls"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/wgk_profile_card"
                app:layout_goneMarginTop="0dp">

                <!-- Unclipped so the connect control's power-down ripple can cross
                     its own bounds — and the top padding, which is all that is
                     left above it once the slack Space has collapsed. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="@dimen/wgk_connect_gap_min"
                    android:paddingEnd="16dp"
                    android:paddingBottom="@dimen/wgk_screen_pad_bottom">

                    <!-- All the slack sits here, above the control, so the button and
                         its caption are pressed down against the status card instead
                         of floating in the middle of the screen. Safe to weight only
                         because everything below the button is now a constant height
                         — the card no longer grows when the stage block appears.
                         The minimum gap under the pinned card is the padding above,
                         not a minHeight here: a weighted child collapses to zero the
                         moment the stack overflows, and the padding survives that. -->
                    <Space
                        android:layout_width="1dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <!-- Slightly smaller than the TV control, leaving room for status
                         and settings without sacrificing the visual anchor. -->
                    <include
                        android:id="@+id/wgk_connect_button_view"
                        layout="@layout/view_wgk_connect_button"
                        android:layout_width="@dimen/wgk_connect_ring_outer"
                        android:layout_height="@dimen/wgk_connect_ring_outer" />

                    <!-- Action slot. One fixed-height band under the button, holding
                         at most one thing at a time.

                         The hint describes the button action; it is shown only where
                         that action is not obvious from the button itself — while
                         connecting, reconnecting or after a failure, where a tap
                         cancels or retries rather than doing the thing the power icon
                         suggests. At rest and while connected the card below already
                         reports the state, so the hint would be the third line saying
                         one fact and the slot is free for the chip.

                         Sharing can only run over a live tunnel, so the chip can only
                         appear in Connected — exactly where the hint is dropped. The
                         two never compete for the width, which is why they can share
                         one slot instead of stacking into two bands.

                         The height is fixed rather than wrapped: the slot is part of
                         the constant-height block under the button (see the status
                         card), and a slot that collapsed when empty would move the
                         button on every state change. -->
                    <FrameLayout
                        android:id="@+id/wgk_action_slot"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/wgk_action_slot_height"
                        android:layout_marginTop="8dp">

                        <TextView
                            android:id="@+id/wgk_headline"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:maxLines="1"
                            android:text="@string/wgk_headline_disconnected"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textColor="@color/wgk_on_surface_variant"
                            app:autoSizeMaxTextSize="16sp"
                            app:autoSizeMinTextSize="13sp"
                            app:autoSizeTextType="uniform" />

                        <!-- Opens the sharing sheet: the session's own counters and
                             its stop button are two taps away through the gear
                             otherwise, and this chip is the thing that reports it. -->
                        <LinearLayout
                            android:id="@+id/wgk_tether_chip"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:background="@drawable/wgk_chip_bg"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="10dp"
                            android:paddingEnd="12dp"
                            android:visibility="gone">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_wifi_tethering"
                                app:tint="@color/wgk_primary" />

                            <TextView
                                android:id="@+id/wgk_tether_chip_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:maxLines="1"
                                android:textAppearance="@style/TextAppearance.WGKeyBot.Eyebrow"
                                android:textColor="@color/wgk_primary" />
                        </LinearLayout>
                    </FrameLayout>

                    <!-- Fixed, so the block below the button stays a constant height
                         and the button keeps its distance from the card. All the
                         slack lives in the weighted spacer above the button now. -->
                    <Space
                        android:layout_width="1dp"
                        android:layout_height="@dimen/wgk_status_gap" />

                    <!-- Status and the two secondary actions form one bottom block. -->
                    <include
                        android:id="@+id/wgk_status_zone"
                        layout="@layout/view_wgk_status_zone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <include
                        android:id="@+id/wgk_footer_row"
                        layout="@layout/view_wgk_footer_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/wgk_footer_gap" />

                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

            <!-- No-auth / expired state. Kept as an overlay so the shared fragment
                 can switch states without recreating the view hierarchy. -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/wgk_no_config_container"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:overScrollMode="ifContentScrolls"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingStart="32dp"
                    android:paddingTop="32dp"
                    android:paddingEnd="32dp"
                    android:paddingBottom="32dp">

                <FrameLayout
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="@drawable/wgk_no_key_icon_bg">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_key"
                        app:tint="@color/wgk_primary" />
                </FrameLayout>

                <TextView
                    android:id="@+id/wgk_no_key_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:gravity="center"
                    android:text="@string/wgk_no_key_title"
                    android:textAppearance="?attr/textAppearanceHeadlineSmall"
                    android:textColor="@color/wgk_on_surface" />

                <TextView
                    android:id="@+id/wgk_no_key_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.35"
                    android:text="@string/wgk_no_key_subtitle"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="@color/wgk_on_surface_variant" />

                <!-- The bot is the primary onboarding route. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/wgk_bot_link_btn"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="24dp"
                    android:text="@string/wgk_no_key_action"
                    android:textColor="@color/wgk_on_primary"
                    app:backgroundTint="@color/wgk_primary"
                    app:cornerRadius="24dp"
                    app:icon="@drawable/ic_send"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconSize="18dp"
                    app:iconTint="@color/wgk_on_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/wgk_or_divider"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="@color/wgk_on_surface_variant" />

                <FrameLayout
                    android:id="@+id/wgk_token_input_wrapper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp">

                    <EditText
                        android:id="@+id/wgk_token_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/wgk_token_field_bg"
                        android:fontFamily="monospace"
                        android:hint="@string/wgk_token_hint"
                        android:inputType="textNoSuggestions"
                        android:maxLines="1"
                        android:paddingStart="14dp"
                        android:paddingTop="14dp"
                        android:paddingEnd="52dp"
                        android:paddingBottom="14dp"
                        android:textColor="@color/wgk_on_surface"
                        android:textColorHint="@color/wgk_on_surface_variant" />

                    <ImageButton
                        android:id="@+id/wgk_paste_btn"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="end|center_vertical"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/wgk_paste_cd"
                        android:src="@drawable/ic_content_paste"
                        app:tint="@color/wgk_on_surface_variant" />
                </FrameLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/wgk_connect_with_token_btn"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:text="@string/wgk_connect_action"
                    android:textColor="@color/wgk_on_primary"
                    app:backgroundTint="@color/wgk_primary"
                    app:cornerRadius="24dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/wgk_check_subscription_btn"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:text="@string/wgk_check_subscription_action"
                    android:visibility="gone"
                    app:backgroundTint="@color/wgk_surface_container_low"
                    app:cornerRadius="24dp"
                    app:strokeColor="@color/wgk_outline" />

                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>
