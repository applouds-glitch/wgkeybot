<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/main_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/wgk_background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Profile card -->
        <include
            android:id="@+id/wgk_profile_card"
            layout="@layout/view_wgk_profile_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Connect button (260dp circle with 3 rings) — centred vertically in remaining space -->
        <include
            android:id="@+id/wgk_connect_button_view"
            layout="@layout/view_wgk_connect_button"
            android:layout_width="260dp"
            android:layout_height="260dp"
            app:layout_constraintTop_toBottomOf="@id/wgk_profile_card"
            app:layout_constraintBottom_toTopOf="@id/wgk_headline"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_constraintVertical_bias="0.5" />

        <!-- Headline text below button -->
        <TextView
            android:id="@+id/wgk_headline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="@string/wgk_headline_disconnected"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="@color/wgk_on_surface_variant"
            app:layout_constraintTop_toBottomOf="@id/wgk_connect_button_view"
            app:layout_constraintBottom_toTopOf="@id/wgk_status_zone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Status zone card -->
        <include
            android:id="@+id/wgk_status_zone"
            layout="@layout/view_wgk_status_zone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/wgk_headline"
            app:layout_constraintBottom_toTopOf="@id/wgk_footer_row"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Footer: split tunneling button + version label -->
        <include
            android:id="@+id/wgk_footer_row"
            layout="@layout/view_wgk_footer_row"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="24dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- "No config" state: shown when tunnel not found -->
        <LinearLayout
            android:id="@+id/wgk_no_config_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone"
            android:paddingHorizontal="32dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Icon circle -->
            <FrameLayout
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="@drawable/wgk_no_key_icon_bg">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_key"
                    app:tint="@color/wgk_primary" />
            </FrameLayout>

            <!-- Title -->
            <TextView
                android:id="@+id/wgk_no_key_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="@string/wgk_no_key_title"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                android:textColor="@color/wgk_on_surface" />

            <!-- Subtitle -->
            <TextView
                android:id="@+id/wgk_no_key_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.4"
                android:text="@string/wgk_no_key_subtitle"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/wgk_on_surface_variant" />

            <!-- Token input -->
            <EditText
                android:id="@+id/wgk_token_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:hint="@string/wgk_token_hint"
                android:fontFamily="monospace"
                android:inputType="textNoSuggestions"
                android:maxLines="1"
                android:padding="14dp"
                android:background="@drawable/wgk_token_field_bg"
                android:textColor="@color/wgk_on_surface"
                android:textColorHint="@color/wgk_on_surface_variant" />

            <!-- Connect with token button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/wgk_connect_with_token_btn"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/wgk_connect_action"
                app:backgroundTint="@color/wgk_primary"
                android:textColor="@color/wgk_on_primary"
                app:cornerRadius="24dp" />

            <!-- Divider -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/wgk_or_divider"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="@color/wgk_on_surface_variant" />

            <!-- Bot button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/wgk_bot_link_btn"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/wgk_no_key_action"
                app:backgroundTint="@color/wgk_primary"
                android:textColor="@color/wgk_on_primary"
                app:cornerRadius="24dp"
                app:icon="@drawable/ic_send"
                app:iconSize="18dp"
                app:iconTint="@color/wgk_on_primary"
                app:iconGravity="textStart"
                app:iconPadding="8dp" />

            <!-- Check subscription button (shown only when expired) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/wgk_check_subscription_btn"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                android:text="@string/wgk_check_subscription_action"
                app:cornerRadius="24dp"
                app:strokeColor="@color/wgk_outline" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>
