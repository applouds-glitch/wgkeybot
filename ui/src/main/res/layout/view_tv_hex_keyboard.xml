<?xml version="1.0" encoding="utf-8"?><!--
  ~ TV hex keyboard for D-pad token input.
  ~ Plain LinearLayout root (not <merge>) so it can be inflated standalone
  ~ by TvHexKeyboard and added into an arbitrary host container.
  -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Token display -->
    <TextView
        android:id="@+id/tv_keyboard_display"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/wgk_token_field_bg"
        android:fontFamily="monospace"
        android:gravity="center"
        android:textColor="@color/wgk_on_surface"
        android:textColorHint="@color/wgk_on_surface_variant"
        android:textSize="14sp"
        android:hint="@string/wgk_token_hint"
        android:maxLines="1" />

    <!-- Row 1: 1 2 3 4 -->
    <LinearLayout
        android:id="@+id/tv_keyboard_row1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tv_key_1"
            style="@style/TvKeyButton"
            android:text="1"
            android:nextFocusRight="@id/tv_key_2"
            android:nextFocusDown="@id/tv_key_5" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tv_key_2"
            style="@style/TvKeyButton"
            android:text="2"
            android:nextFocusLeft="@id/tv_key_1"
            android:nextFocusRight="@id/tv_key_3"
            android:nextFocusDown="@id/tv_key_6" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tv_key_3"
            style="@style/TvKeyButton"
            android:text="3"
            android:nextFocusLeft="@id/tv_key_2"
            android:nextFocusRight="@id/tv_key_4"
            android:nextFocusDown="@id/tv_key_7" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tv_key_4"
            style="@style/TvKeyButton"
            android:text="4"
            android:nextFocusLeft="@id/tv_key_3"
            android:nextFocusDown="@id/tv_key_8" />
    </LinearLayout>

    <!-- Row 2: 5 6 7 8 -->
    <LinearLayout
        android:id="@+id/tv_keyboard_row2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tv_key_5"
            style="@style/TvKeyButton"
            android:text="5"
            android:nextFocusUp="@id/tv_key_1"
            android:nextFocusRight="@id/tv_key_6"
            android:nextFocusDown="@id/tv_key_9" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tv_key_6"
            style="@style/TvKeyButton"
            android:text="6"
            android:nextFocusUp="@id/tv_key_2"
            android:nextFocusLeft="@id/tv_key_5"
            android:nextFocusRight="@id/tv_key_7"
            android:nextFocusDown="@id/tv_key_0" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tv_key_7"
            style="@style/TvKeyButton"
            android:text="7"
            android:nextFocusUp="@id/tv_key_3"
            android:nextFocusLeft="@id/tv_key_6"
            android:nextFocusRight="@id/tv_key_8"
            android:nextFocusDown="@id/tv_key_a" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tv_key_8"
            style="@style/TvKeyButton"
            android:text="8"
            android:nextFocusUp="@id/tv_key_4"
            android:nextFocusLeft="@id/tv_key_7"
            android:nextFocusDown="@id/tv_key_b" />
    </LinearLayout>

    <!-- Row 3: 9 0 A B -->
    <LinearLayout
        android:id="@+id/tv_keyboard_row3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tv_key_9"
            style="@style/TvKeyButton"
            android:text="9"
            android:nextFocusUp="@id/tv_key_5"
            android:nextFocusRight="@id/tv_key_0"
            android:nextFocusDown="@id/tv_key_c" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tv_key_0"
            style="@style/TvKeyButton"
            android:text="0"
            android:nextFocusUp="@id/tv_key_6"
            android:nextFocusLeft="@id/tv_key_9"
            android:nextFocusRight="@id/tv_key_a"
            android:nextFocusDown="@id/tv_key_d" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tv_key_a"
            style="@style/TvKeyButton"
            android:text="A"
            android:nextFocusUp="@id/tv_key_7"
            android:nextFocusLeft="@id/tv_key_0"
            android:nextFocusRight="@id/tv_key_b"
            android:nextFocusDown="@id/tv_key_e" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tv_key_b"
            style="@style/TvKeyButton"
            android:text="B"
            android:nextFocusUp="@id/tv_key_8"
            android:nextFocusLeft="@id/tv_key_a"
            android:nextFocusDown="@id/tv_key_f" />
    </LinearLayout>

    <!-- Row 4: C D E F -->
    <LinearLayout
        android:id="@+id/tv_keyboard_row4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tv_key_c"
            style="@style/TvKeyButton"
            android:text="C"
            android:nextFocusUp="@id/tv_key_9"
            android:nextFocusRight="@id/tv_key_d"
            android:nextFocusDown="@id/tv_key_backspace" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tv_key_d"
            style="@style/TvKeyButton"
            android:text="D"
            android:nextFocusUp="@id/tv_key_0"
            android:nextFocusLeft="@id/tv_key_c"
            android:nextFocusRight="@id/tv_key_e"
            android:nextFocusDown="@id/tv_key_clear" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tv_key_e"
            style="@style/TvKeyButton"
            android:text="E"
            android:nextFocusUp="@id/tv_key_a"
            android:nextFocusLeft="@id/tv_key_d"
            android:nextFocusRight="@id/tv_key_f"
            android:nextFocusDown="@id/tv_key_connect" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tv_key_f"
            style="@style/TvKeyButton"
            android:text="F"
            android:nextFocusUp="@id/tv_key_b"
            android:nextFocusLeft="@id/tv_key_e"
            android:nextFocusDown="@id/tv_key_connect" />
    </LinearLayout>

    <!-- Row 5: Backspace / Clear / Connect -->
    <LinearLayout
        android:id="@+id/tv_keyboard_row5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tv_key_backspace"
            style="@style/TvKeyButton.Action"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="⌫"
            android:nextFocusUp="@id/tv_key_c"
            android:nextFocusRight="@id/tv_key_clear"
            android:nextFocusDown="@id/tv_key_backspace" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tv_key_clear"
            style="@style/TvKeyButton.Action"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/tv_keyboard_clear"
            android:nextFocusUp="@id/tv_key_d"
            android:nextFocusLeft="@id/tv_key_backspace"
            android:nextFocusRight="@id/tv_key_connect"
            android:nextFocusDown="@id/tv_key_clear" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tv_key_connect"
            style="@style/TvKeyButton.Connect"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/wgk_connect_action"
            android:nextFocusUp="@id/tv_key_e"
            android:nextFocusLeft="@id/tv_key_clear"
            android:nextFocusDown="@id/tv_key_connect" />
    </LinearLayout>

</LinearLayout>
