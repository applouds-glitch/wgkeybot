<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.WGKeyBot.InstrumentCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- v1.6.0 status stack and protocol label. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/wgk_status_label"
                        android:textAppearance="@style/TextAppearance.WGKeyBot.LabelMono" />
                    <TextView
                        android:id="@+id/wgk_status_headline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:accessibilityLiveRegion="polite"
                        android:text="@string/wgk_status_disconnected"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="@color/wgk_on_surface" />
                    <TextView
                        android:id="@+id/wgk_status_sub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:accessibilityLiveRegion="polite"
                        android:text="@string/wgk_status_sub_disconnected"
                        android:textAppearance="@style/TextAppearance.WGKeyBot.ClassicStatusDetail" />
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/wgk_wireguard_label"
                    android:textAppearance="@style/TextAppearance.WGKeyBot.LabelMono" />
            </LinearLayout>

            <!-- Keep both measured so the stage-to-metrics transition does not move the card. -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:minHeight="40dp">
                <LinearLayout
                    android:id="@+id/wgk_stage_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:orientation="vertical">
                    <!-- Classic three-segment strip, independent of label widths. -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/wgk_stage_tunnel_indicator"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="3dp"
                            android:importantForAccessibility="no"
                            android:indeterminate="false"
                            android:max="100"
                            app:indicatorColor="@color/wgk_primary"
                            app:trackColor="@color/wgk_divider"
                            app:trackCornerRadius="2dp"
                            app:trackThickness="3dp"
                            app:indicatorTrackGapSize="0dp"
                            app:trackStopIndicatorSize="0dp" />
                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/wgk_stage_handshake_indicator"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginHorizontal="3dp"
                            android:importantForAccessibility="no"
                            android:indeterminate="false"
                            android:max="100"
                            app:indicatorColor="@color/wgk_primary"
                            app:trackColor="@color/wgk_divider"
                            app:trackCornerRadius="2dp"
                            app:trackThickness="3dp"
                            app:indicatorTrackGapSize="0dp"
                            app:trackStopIndicatorSize="0dp" />
                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/wgk_stage_routing_indicator"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="3dp"
                            android:importantForAccessibility="no"
                            android:indeterminate="false"
                            android:max="100"
                            app:indicatorColor="@color/wgk_primary"
                            app:trackColor="@color/wgk_divider"
                            app:trackCornerRadius="2dp"
                            app:trackThickness="3dp"
                            app:indicatorTrackGapSize="0dp"
                            app:trackStopIndicatorSize="0dp" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="start|center_vertical"
                            android:orientation="horizontal">
                            <View
                                android:id="@+id/wgk_dot_tunnel"
                                android:layout_width="6dp"
                                android:layout_height="6dp"
                                android:layout_marginEnd="6dp"
                                android:importantForAccessibility="no"
                                android:background="@drawable/wgk_stage_dot" />
                            <TextView
                                android:id="@+id/wgk_lbl_tunnel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxLines="2"
                                android:text="@string/wgk_stage_tunnel"
                                android:textAppearance="@style/TextAppearance.WGKeyBot.StageLabel" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="horizontal">
                            <View
                                android:id="@+id/wgk_dot_handshake"
                                android:layout_width="6dp"
                                android:layout_height="6dp"
                                android:layout_marginEnd="6dp"
                                android:importantForAccessibility="no"
                                android:background="@drawable/wgk_stage_dot" />
                            <TextView
                                android:id="@+id/wgk_lbl_handshake"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxLines="2"
                                android:text="@string/wgk_stage_handshake"
                                android:textAppearance="@style/TextAppearance.WGKeyBot.StageLabel" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end|center_vertical"
                            android:orientation="horizontal">
                            <View
                                android:id="@+id/wgk_dot_routing"
                                android:layout_width="6dp"
                                android:layout_height="6dp"
                                android:layout_marginEnd="6dp"
                                android:importantForAccessibility="no"
                                android:background="@drawable/wgk_stage_dot" />
                            <TextView
                                android:id="@+id/wgk_lbl_routing"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxLines="2"
                                android:text="@string/wgk_stage_routing"
                                android:textAppearance="@style/TextAppearance.WGKeyBot.StageLabel" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/wgk_metrics_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    android:visibility="invisible">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingEnd="8dp"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="2"
                            android:text="@string/wgk_status_uptime_label"
                            android:textAppearance="@style/TextAppearance.WGKeyBot.LabelMono" />
                        <TextView
                            android:id="@+id/wgk_uptime_value"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:maxLines="1"
                            android:text="@string/wgk_status_metric_empty"
                            android:textAppearance="@style/TextAppearance.WGKeyBot.ValueMono"
                            android:textColor="@color/wgk_on_surface"
                            app:autoSizeMaxTextSize="14sp"
                            app:autoSizeMinTextSize="11sp"
                            app:autoSizeTextType="uniform" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingEnd="8dp"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="2"
                            android:text="@string/wgk_status_received_label"
                            android:textAppearance="@style/TextAppearance.WGKeyBot.LabelMono" />
                        <TextView
                            android:id="@+id/wgk_received_value"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:maxLines="1"
                            android:text="@string/wgk_status_metric_empty"
                            android:textAppearance="@style/TextAppearance.WGKeyBot.ValueMono"
                            android:textColor="@color/wgk_on_surface"
                            app:autoSizeMaxTextSize="14sp"
                            app:autoSizeMinTextSize="11sp"
                            app:autoSizeTextType="uniform" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingEnd="8dp"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="2"
                            android:text="@string/wgk_status_sent_label"
                            android:textAppearance="@style/TextAppearance.WGKeyBot.LabelMono" />
                        <TextView
                            android:id="@+id/wgk_sent_value"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:maxLines="1"
                            android:text="@string/wgk_status_metric_empty"
                            android:textAppearance="@style/TextAppearance.WGKeyBot.ValueMono"
                            android:textColor="@color/wgk_on_surface"
                            app:autoSizeMaxTextSize="14sp"
                            app:autoSizeMinTextSize="11sp"
                            app:autoSizeTextType="uniform" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>
