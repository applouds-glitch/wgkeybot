<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Expert mode's VK call links: the user's own list, and the bot's for
         comparison, each with a check against VK. Same skeleton as the routing
         screen — toolbar over a width-capped column of cards; insets applied in
         the activity. The field is a bare text area rather than a row with a
         dialog: up to eight links are a list to look at, not a value to set. -->
    <LinearLayout
        android:id="@+id/wgk_links_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/wgk_background"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/wgk_links_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:title="@string/wgk_vk_links_title"
            app:titleTextColor="@color/wgk_on_surface"
            app:titleTextAppearance="@style/TextAppearance.WGKeyBot.ScreenTitle" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/wgk_links_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="ifContentScrolls">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/wgk_settings_gutter"
                    android:paddingTop="12dp"
                    android:paddingEnd="@dimen/wgk_settings_gutter"
                    android:paddingBottom="24dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintWidth_max="@dimen/wgk_settings_content_max">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:text="@string/wgk_vk_links_own_section"
                        android:textAppearance="@style/TextAppearance.WGKeyBot.SectionHeader" />

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.WGKeyBot.InstrumentCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="16dp"
                            android:paddingTop="16dp"
                            android:paddingEnd="16dp"
                            android:paddingBottom="12dp">

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/wgk_links_input_layout"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/wgk_vk_links_hint">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/wgk_links_input"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="top|start"
                                    android:inputType="textMultiLine|textUri|textNoSuggestions"
                                    android:minLines="3"
                                    android:maxLines="10" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <!-- Two buttons, side by side: checking does not save
                                 and saving does not check, and both are wanted. -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:orientation="horizontal">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/wgk_links_check_btn"
                                    style="@style/Widget.WGKeyBot.InstrumentButton"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="8dp"
                                    android:layout_weight="1"
                                    android:text="@string/wgk_vk_links_check"
                                    app:icon="@drawable/ic_check" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/wgk_links_save_btn"
                                    style="@style/Widget.WGKeyBot.InstrumentButton"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/wgk_vk_links_save"
                                    app:icon="@drawable/ic_action_save" />
                            </LinearLayout>

                            <!-- Verdicts of the last check of this list, or what
                                 was wrong with the text; gone when nothing. -->
                            <TextView
                                android:id="@+id/wgk_links_own_status"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:textAppearance="?attr/textAppearanceBodySmall"
                                android:textColor="@color/wgk_on_surface_variant"
                                android:visibility="gone" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:text="@string/wgk_vk_links_note"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="@color/wgk_on_surface_variant" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/wgk_settings_section_gap"
                        android:layout_marginBottom="8dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:text="@string/wgk_vk_links_config_section"
                        android:textAppearance="@style/TextAppearance.WGKeyBot.SectionHeader" />

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.WGKeyBot.InstrumentCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <include
                                android:id="@+id/wgk_links_config_row"
                                layout="@layout/view_wgk_settings_row"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/wgk_links_config_check_btn"
                                style="@style/Widget.WGKeyBot.InstrumentButton"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="16dp"
                                android:layout_marginTop="4dp"
                                android:layout_marginEnd="16dp"
                                android:layout_marginBottom="12dp"
                                android:text="@string/wgk_vk_links_check_config"
                                app:icon="@drawable/ic_check" />

                            <TextView
                                android:id="@+id/wgk_links_config_status"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="16dp"
                                android:layout_marginEnd="16dp"
                                android:layout_marginBottom="12dp"
                                android:textAppearance="?attr/textAppearanceBodySmall"
                                android:textColor="@color/wgk_on_surface_variant"
                                android:visibility="gone" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</layout>
