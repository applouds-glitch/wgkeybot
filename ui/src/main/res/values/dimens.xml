<resources>
    <dimen name="fab_margin">16dp</dimen>
    <dimen name="bottom_sheet_item_height">56dp</dimen>
    <dimen name="normal_margin">8dp</dimen>
    <dimen name="bottom_sheet_top_padding">8dp</dimen>
    <dimen name="bottom_sheet_icon_padding">16dp</dimen>
    <dimen name="tunnel_list_placeholder_margin">16dp</dimen>
    <dimen name="wgk_snackbar_icon_padding">8dp</dimen>

    <!-- Connect screen metrics. This file is the *compact* set: it is what short
         screens get (16:9 phones, landscape, and any device whose display-size or
         font setting shrinks the available height). The roomy set lives in
         values-h680dp / values-h760dp — Android picks the largest bucket that
         still fits, so tall phones keep the original design untouched.

         The screen is a fixed stack: the status card and footer rows do not
         shrink, so the only thing that can give when the viewport gets short is
         the connect ring and the gaps around it. Each bucket is cut so its own
         stack fits its smallest device, against a viewport of screenHeightDp
         minus the 56dp action bar: compact ~596dp (needs 652dp of screen
         height), medium ~636dp (692), full ~684dp (740). Below ~650dp even the
         compact stack scrolls — which is why the profile card is pinned outside
         the scroll view in tunnel_list_fragment.xml rather than riding it.

         Ring geometry, keep proportional: mid ≈ 0.88·outer, inner ≈ 0.76·outer,
         arc = inner + 2 (the arc centreline must land on the inner ring's
         stroke), button ≈ 0.67·outer, icon ≈ 0.24·outer. -->
    <dimen name="wgk_connect_ring_outer">176dp</dimen>
    <dimen name="wgk_connect_ring_mid">154dp</dimen>
    <dimen name="wgk_connect_ring_inner">134dp</dimen>
    <dimen name="wgk_connect_arc">136dp</dimen>
    <dimen name="wgk_connect_btn">118dp</dimen>
    <dimen name="wgk_connect_icon">42dp</dimen>

    <!-- Top margin of the pinned profile card. -->
    <dimen name="wgk_screen_pad_top">12dp</dimen>
    <dimen name="wgk_screen_pad_bottom">16dp</dimen>
    <!-- Minimum gap between the pinned card and the connect ring: it is the
         scroll content's top padding, since the weighted spacer that normally
         holds them apart collapses to zero as soon as the stack overflows. -->
    <dimen name="wgk_connect_gap_min">8dp</dimen>
    <!-- Action slot under the connect button: the band that carries either the
         action hint or the sharing chip. Not bucketed by height like the ring —
         it is sized by the chip inside it, which does not scale with the screen.
         Its 28dp plus an 8dp top margin replaced the hint's own 21dp line plus a
         12dp margin, so the fixed block under the button grew by 3dp. -->
    <dimen name="wgk_action_slot_height">28dp</dimen>
    <!-- One line box of the status card's subtitle, in sp so it tracks the user's
         font setting instead of clipping at large sizes. The subtitle autosizes
         down to fit a long state on a narrow card; without this floor the card —
         and with it the connect button above — would shift by a couple of dp
         whenever the text shrank. -->
    <dimen name="wgk_status_sub_min_height">16sp</dimen>
    <!-- Fixed gap between the action slot and the status card. -->
    <dimen name="wgk_status_gap">16dp</dimen>
    <dimen name="wgk_footer_gap">12dp</dimen>

    <!-- TV keyboard key height. The grid holds 0-9 a-z in 6 rows, so with the
         display, the nav row and the action row on top of it the whole keyboard
         is ~7.5 keys tall — it has to fit 540dp of TV screen minus the action
         bar. Keep the row gap in TvTokenKeyboard.GRID_ROW_GAP_DP in step. -->
    <dimen name="wgk_tv_key_height">44dp</dimen>
    <!-- Settings screen. The content column is capped rather than stretched:
         the manifest still locks the screen to portrait, but Android 16 ignores
         that lock on sw>=600dp, so tablets and unfolded foldables arrive here in
         landscape, and a 900dp-wide row holding two short lines of text reads
         badly. Below 600dp the cap changes nothing — the column simply takes the
         width it is given minus the gutters. -->
    <dimen name="wgk_settings_content_max">600dp</dimen>
    <dimen name="wgk_settings_gutter">16dp</dimen>
    <dimen name="wgk_settings_section_gap">20dp</dimen>
    <!-- A minimum, not a fixed height: with a large system font the row has to
         grow rather than clip its text. -->
    <dimen name="wgk_settings_row_min">56dp</dimen>
</resources>
