<resources>
    <style name="WireGuardTheme" parent="Theme.Material3.Light">
        <item name="colorPrimary">@color/md_theme_light_primary</item>
        <item name="colorOnPrimary">@color/md_theme_light_onPrimary</item>
        <item name="colorPrimaryContainer">@color/md_theme_light_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md_theme_light_onPrimaryContainer</item>
        <item name="colorSecondary">@color/md_theme_light_secondary</item>
        <item name="colorOnSecondary">@color/md_theme_light_onSecondary</item>
        <item name="colorSecondaryContainer">@color/md_theme_light_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/md_theme_light_onSecondaryContainer</item>
        <item name="colorTertiary">@color/md_theme_light_tertiary</item>
        <item name="colorOnTertiary">@color/md_theme_light_onTertiary</item>
        <item name="colorTertiaryContainer">@color/md_theme_light_tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/md_theme_light_onTertiaryContainer</item>
        <item name="colorError">@color/md_theme_light_error</item>
        <item name="colorErrorContainer">@color/md_theme_light_errorContainer</item>
        <item name="colorOnError">@color/md_theme_light_onError</item>
        <item name="colorOnErrorContainer">@color/md_theme_light_onErrorContainer</item>
        <item name="android:colorBackground">@color/md_theme_light_background</item>
        <item name="colorOnBackground">@color/md_theme_light_onBackground</item>
        <item name="colorSurface">@color/md_theme_light_surface</item>
        <item name="colorOnSurface">@color/md_theme_light_onSurface</item>
        <item name="colorSurfaceVariant">@color/md_theme_light_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/md_theme_light_onSurfaceVariant</item>
        <item name="colorOutline">@color/md_theme_light_outline</item>
        <item name="colorOnSurfaceInverse">@color/md_theme_light_inverseOnSurface</item>
        <item name="colorSurfaceInverse">@color/md_theme_light_inverseSurface</item>
        <item name="colorPrimaryInverse">@color/md_theme_light_inversePrimary</item>
    </style>

    <!-- WGKeyBot Connect screen styles -->

    <!-- The status card's type, matched to the iOS StatusCard. Monospace is kept
         for the numeric readout alone; the eyebrow labels are sans there, carried
         as labels by caps and tracking rather than by a second typeface. -->

    <!-- iOS: .caption2.weight(.semibold), tracking 1, uppercase. -->
    <style name="TextAppearance.WGKeyBot.Eyebrow" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.09</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/wgk_on_surface_variant</item>
    </style>

    <!-- iOS: .title2.weight(.bold), tracking -0.6 — negative tracking at this size
         keeps a two-word state from looking loose. Set two steps below the iOS 22pt:
         this card carries its stage block in every state, and the headline was the
         cheapest place to buy that height back. -->
    <style name="TextAppearance.WGKeyBot.StatusHeadline" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.03</item>
    </style>

    <!-- iOS: .system(.callout, design: .monospaced).weight(.semibold). No tracking:
         the digits change every couple of seconds and wide spacing makes them
         jitter. -->
    <style name="TextAppearance.WGKeyBot.ValueMono" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- iOS: .system(.caption2, design: .monospaced) — the unit under the figure. -->
    <style name="TextAppearance.WGKeyBot.UnitMono" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/wgk_on_surface_variant</item>
    </style>

    <!-- No outline: the disconnected state reads as a raised light disc on the
         tinted field, carried by its fill and elevation alone. -->
    <style name="Widget.WGKeyBot.ConnectButton" parent="Widget.Material3.Button.IconButton.Filled">
        <item name="android:layout_width">156dp</item>
        <item name="android:layout_height">156dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Material3.Corner.Full</item>
        <item name="iconSize">56dp</item>
        <item name="iconGravity">textTop</item>
        <item name="iconPadding">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="elevation">12dp</item>
    </style>

    <style name="Theme.WGKeyBot.FullScreen" parent="WireGuardTheme">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/wgk_background</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Activity</item>
    </style>

    <style name="Widget.WGKeyBot.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/wgk_surface_container</item>
        <item name="strokeColor">@color/wgk_outline_variant</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <!-- Section header on the settings screen. Small, uppercase and quiet: it
         labels the card below it without competing with the row titles inside
         that card for the eye. -->
    <style name="TextAppearance.WGKeyBot.SectionHeader" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">@color/wgk_on_surface_variant</item>
    </style>
</resources>
