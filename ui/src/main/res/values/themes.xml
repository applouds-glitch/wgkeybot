<resources>
    <style name="WireGuardTheme" parent="Theme.Material3.Light">
        <item name="colorPrimary">@color/md_theme_light_primary</item>
        <item name="colorOnPrimary">@color/md_theme_light_onPrimary</item>
        <item name="colorPrimaryContainer">@color/md_theme_light_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md_theme_light_onPrimaryContainer</item>
        <item name="colorSecondary">@color/md_theme_light_secondary</item>
        <item name="colorOnSecondary">@color/md_theme_light_onSecondary</item>
        <item name="colorSecondaryContainer">@color/md_theme_light_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/md_theme_light_onSecondaryContainer</item>
        <item name="colorTertiary">@color/md_theme_light_tertiary</item>
        <item name="colorOnTertiary">@color/md_theme_light_onTertiary</item>
        <item name="colorTertiaryContainer">@color/md_theme_light_tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/md_theme_light_onTertiaryContainer</item>
        <item name="colorError">@color/md_theme_light_error</item>
        <item name="colorErrorContainer">@color/md_theme_light_errorContainer</item>
        <item name="colorOnError">@color/md_theme_light_onError</item>
        <item name="colorOnErrorContainer">@color/md_theme_light_onErrorContainer</item>
        <item name="android:colorBackground">@color/md_theme_light_background</item>
        <item name="colorOnBackground">@color/md_theme_light_onBackground</item>
        <item name="colorSurface">@color/md_theme_light_surface</item>
        <item name="colorSurfaceBright">@color/md_theme_light_surfaceBright</item>
        <item name="colorSurfaceDim">@color/md_theme_light_surfaceDim</item>
        <item name="colorSurfaceContainerLowest">@color/md_theme_light_surfaceContainerLowest</item>
        <item name="colorSurfaceContainerLow">@color/md_theme_light_surfaceContainerLow</item>
        <item name="colorSurfaceContainer">@color/md_theme_light_surfaceContainer</item>
        <item name="colorSurfaceContainerHigh">@color/md_theme_light_surfaceContainerHigh</item>
        <item name="colorSurfaceContainerHighest">@color/md_theme_light_surfaceContainerHighest</item>
        <item name="colorOnSurface">@color/md_theme_light_onSurface</item>
        <item name="colorSurfaceVariant">@color/md_theme_light_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/md_theme_light_onSurfaceVariant</item>
        <item name="colorOutline">@color/md_theme_light_outline</item>
        <item name="colorOutlineVariant">@color/md_theme_light_outlineVariant</item>
        <item name="colorOnSurfaceInverse">@color/md_theme_light_inverseOnSurface</item>
        <item name="colorSurfaceInverse">@color/md_theme_light_inverseSurface</item>
        <item name="colorPrimaryInverse">@color/md_theme_light_inversePrimary</item>
        <item name="actionBarStyle">@style/Widget.WGKeyBot.ActionBar</item>
    </style>

    <style name="Widget.WGKeyBot.ActionBar" parent="Widget.Material3.ActionBar.Solid">
        <item name="background">@color/wgk_top_bar</item>
        <item name="elevation">0dp</item>
    </style>

    <!-- WGKeyBot Connect screen styles -->

    <style name="Widget.WGKeyBot.ConnectRing.Outer" parent="">
        <item name="android:alpha">0.18</item>
    </style>
    <style name="Widget.WGKeyBot.ConnectRing.Middle" parent="">
        <item name="android:alpha">0.28</item>
    </style>
    <style name="Widget.WGKeyBot.ConnectRing.Inner" parent="">
        <item name="android:alpha">0.42</item>
    </style>

    <!-- Material labels for supporting text; monospace only for live readouts. -->

    <style name="TextAppearance.WGKeyBot.Eyebrow" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">@color/wgk_on_surface_variant</item>
    </style>

    <!-- Technical status labels from the original connect screen. -->
    <style name="TextAppearance.WGKeyBot.LabelMono" parent="TextAppearance.Material3.LabelSmall">
        <item name="fontFamily">monospace</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.16</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/wgk_on_surface_variant</item>
    </style>

    <style name="TextAppearance.WGKeyBot.ClassicStatusDetail" parent="TextAppearance.Material3.BodySmall">
        <item name="fontFamily">monospace</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/wgk_on_surface_variant</item>
    </style>

    <style name="TextAppearance.WGKeyBot.StageLabel" parent="TextAppearance.Material3.LabelSmall">
        <item name="fontFamily">monospace</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/wgk_on_surface_variant</item>
    </style>

    <!-- iOS: .system(.callout, design: .monospaced).weight(.semibold). No tracking:
         the digits change every couple of seconds and wide spacing makes them
         jitter. -->
    <style name="TextAppearance.WGKeyBot.ValueMono" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">monospace</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">normal</item>
    </style>

    <!-- iOS: .system(.caption2, design: .monospaced) — the unit under the figure. -->
    <style name="TextAppearance.WGKeyBot.UnitMono" parent="TextAppearance.Material3.LabelSmall">
        <item name="fontFamily">monospace</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/wgk_on_surface_variant</item>
    </style>

    <!-- Neutral idle disc; selectors supply the connecting and connected accents. -->
    <style name="Widget.WGKeyBot.ConnectButton" parent="Widget.Material3.Button.IconButton.Filled">
        <item name="android:layout_width">156dp</item>
        <item name="android:layout_height">156dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Material3.Corner.Full</item>
        <item name="iconSize">56dp</item>
        <item name="iconGravity">textTop</item>
        <item name="iconPadding">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="elevation">@dimen/wgk_connect_elevation</item>
    </style>

    <style name="Theme.WGKeyBot.FullScreen" parent="WireGuardTheme">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/wgk_background</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Activity</item>
    </style>

    <style name="Widget.WGKeyBot.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/wgk_card_surface</item>
        <item name="strokeColor">@color/wgk_card_outline</item>
        <item name="strokeWidth">@dimen/wgk_card_stroke_width</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="Widget.WGKeyBot.InstrumentCard" parent="Widget.WGKeyBot.Card">
        <item name="cardCornerRadius">22dp</item>
        <item name="contentPadding">0dp</item>
        <item name="android:clipToOutline">true</item>
    </style>

    <style name="TextAppearance.WGKeyBot.InstrumentValue" parent="TextAppearance.Material3.BodySmall">
        <item name="fontFamily">monospace</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/wgk_on_surface_variant</item>
    </style>

    <style name="Widget.WGKeyBot.ProfileAction" parent="Widget.Material3.Button.IconButton">
        <item name="iconTint">@color/wgk_primary</item>
    </style>

    <style name="Widget.WGKeyBot.ConfigAction" parent="Widget.Material3.Button.IconButton.Outlined">
        <item name="android:insetLeft">4dp</item>
        <item name="android:insetRight">4dp</item>
        <item name="android:insetTop">4dp</item>
        <item name="android:insetBottom">4dp</item>
        <item name="iconGravity">textTop</item>
        <item name="iconPadding">0dp</item>
        <item name="iconSize">18dp</item>
        <item name="iconTint">@color/wgk_on_surface_variant</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/wgk_outline_variant</item>
    </style>

    <style name="TextAppearance.WGKeyBot.SectionHeader" parent="TextAppearance.WGKeyBot.LabelMono" />

    <style name="TextAppearance.WGKeyBot.ScreenTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">20sp</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/wgk_on_surface</item>
    </style>

    <style name="TextAppearance.WGKeyBot.SettingTitle" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/wgk_on_surface</item>
    </style>

    <style name="TextAppearance.WGKeyBot.SupportingText" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/wgk_on_surface_variant</item>
    </style>

    <style name="TextAppearance.WGKeyBot.NetworkValue" parent="TextAppearance.WGKeyBot.InstrumentValue">
        <item name="android:textSize">14sp</item>
        <item name="lineHeight">20sp</item>
        <item name="android:lineHeight">20sp</item>
        <item name="android:textColor">@color/wgk_on_surface</item>
    </style>

    <style name="TextAppearance.WGKeyBot.SessionValue" parent="TextAppearance.WGKeyBot.InstrumentValue">
        <item name="android:textSize">18sp</item>
        <item name="lineHeight">24sp</item>
        <item name="android:lineHeight">24sp</item>
        <item name="android:textColor">@color/wgk_on_surface</item>
    </style>

    <style name="Widget.WGKeyBot.InstrumentButton" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">8dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAppearance">@style/TextAppearance.WGKeyBot.SettingTitle</item>
        <item name="iconSize">18dp</item>
    </style>

    <style name="ThemeOverlay.WGKeyBot.InstrumentSheet" parent="WireGuardTheme.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.WGKeyBot.InstrumentSheet</item>
    </style>

    <style name="Widget.WGKeyBot.InstrumentSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.WGKeyBot.InstrumentSheet</item>
        <item name="backgroundTint">@color/wgk_background</item>
    </style>

    <style name="ShapeAppearanceOverlay.WGKeyBot.InstrumentSheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">22dp</item>
        <item name="cornerSizeTopRight">22dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
</resources>
